<Window x:Class="JarvisCode.App.Views.ThemePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:JarvisCode.App.Controls"
        Title="Themes"
        Width="920" Height="660"
        MinWidth="520" MinHeight="420"
        FontFamily="{DynamicResource UiFontFamily}"
        Foreground="{DynamicResource Text100Brush}"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Bg100Brush}"
            BorderBrush="{DynamicResource BorderMidBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title strip -->
            <Grid Grid.Row="0" Background="{DynamicResource Bg300Brush}">
                <TextBlock Text="Themes" FontSize="13" FontWeight="Medium"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text200Brush}" />
                <Button Style="{StaticResource IconButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        HorizontalAlignment="Right" Width="46" Height="40"
                        Click="OnCloseClick"
                        AutomationProperties.Name="Close themes">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFontFamily}" FontSize="11" />
                </Button>
            </Grid>

            <!-- Filter -->
            <Grid Grid.Row="1" Margin="22,14,22,4">
                <TextBox x:Name="FilterBox"
                         Style="{StaticResource InputTextBox}"
                         controls:PlaceholderText.Text="Filter themes…   (press / to focus, Enter to apply, Esc to close)"
                         TextChanged="OnFilterChanged"
                         AutomationProperties.Name="Filter themes" />
            </Grid>

            <!-- Card grid -->
            <ScrollViewer x:Name="Scroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="22,6,22,22">
                <StackPanel x:Name="SectionsHost" KeyboardNavigation.DirectionalNavigation="Contained" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
