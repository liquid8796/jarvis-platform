<Window x:Class="JarvisCode.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:JarvisCode.App.Views"
        Title="Jarvis Code"
        Width="1280" Height="840"
        MinWidth="320" MinHeight="240"
        FontFamily="{DynamicResource UiFontFamily}"
        Foreground="{DynamicResource Text100Brush}"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Caption buttons -->
        <Style x:Key="CaptionButton" TargetType="{x:Type Button}">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text300Brush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text100Brush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ActiveOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#B3271A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Surface segmented control (Chat | Code) -->
        <Style x:Key="SurfaceSegment" TargetType="{x:Type RadioButton}">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource Text300Brush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Root" CornerRadius="7" Padding="14,5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg000Brush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text100Brush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderIconButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource IconButton}">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowRoot" Background="{DynamicResource Bg100Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="36" />
                <RowDefinition x:Name="HeaderRow" Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title-bar overlay strip (36px) -->
            <Grid Grid.Row="0" Background="{DynamicResource Bg300Brush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <views:SpinnerGlyph x:Name="AppGlyph" Width="16" Height="16" IsSpinning="False" />
                    <!--
                        The reference has no menu bar on Windows: its title bar asks the
                        main process to pop the application menu (requestMainMenuPopup).
                    -->
                    <Button x:Name="MenuButton" Style="{StaticResource CaptionButton}"
                            Width="32" Margin="6,0,0,0" FontSize="12"
                            Content="&#xE700;" AutomationProperties.Name="Application menu"
                            Click="OnMenuButtonClick" />
                </StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text200Brush}"
                           FontSize="13" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            AutomationProperties.Name="Minimize" Click="OnMinimizeClick" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            AutomationProperties.Name="Maximize" Click="OnMaximizeRestoreClick" />
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                            AutomationProperties.Name="Close" Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <!-- Header (48px): nav left, surface tabs center -->
            <Grid Grid.Row="1" Background="{DynamicResource Bg300Brush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="SidebarToggle" Style="{StaticResource HeaderIconButton}" Content="&#xE700;"
                            AutomationProperties.Name="Toggle sidebar"
                            ToolTip="Toggle sidebar" Click="OnSidebarToggleClick" />
                    <Button x:Name="BackButton" Style="{StaticResource HeaderIconButton}" Content="&#xE72B;"
                            AutomationProperties.Name="Back"
                            Margin="4,0,0,0" Click="OnBackClick" />
                    <Button x:Name="ForwardButton" Style="{StaticResource HeaderIconButton}" Content="&#xE72A;"
                            AutomationProperties.Name="Forward"
                            Click="OnForwardClick" />
                </StackPanel>

                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Bg200Brush}"
                        CornerRadius="9" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ChatTab" Style="{StaticResource SurfaceSegment}" Content="Chat"
                                     GroupName="Surface" IsChecked="True" Checked="OnSurfaceChecked" />
                        <RadioButton x:Name="CodeTab" Style="{StaticResource SurfaceSegment}" Content="Code"
                                     GroupName="Surface" Checked="OnSurfaceChecked" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="ThemeButton" Style="{StaticResource HeaderIconButton}" Content="&#xE790;"
                            AutomationProperties.Name="Themes"
                            ToolTip="Themes (Ctrl+Shift+T)" Click="OnThemePickerClick" />
                    <Button x:Name="SettingsButton" Style="{StaticResource HeaderIconButton}" Content="&#xE713;"
                            AutomationProperties.Name="Settings"
                            ToolTip="Settings" Click="OnSettingsClick" />
                </StackPanel>
            </Grid>

            <!-- Body: sidebar + content -->
            <Grid x:Name="BodyGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="288" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <views:SidebarView x:Name="Sidebar" Grid.Column="0" />
                <customize:CustomizeNavView x:Name="CustomizeNav" Grid.Column="0" Visibility="Collapsed"
                                            xmlns:customize="clr-namespace:JarvisCode.App.Views.Customize" />
                <GridSplitter x:Name="SidebarSplitter" Grid.Column="0" Width="5"
                              HorizontalAlignment="Right" VerticalAlignment="Stretch"
                              Background="Transparent" ShowsPreview="False" Focusable="False"
                              ResizeBehavior="CurrentAndNext" ResizeDirection="Columns"
                              DragCompleted="OnSidebarSplitterDragCompleted"
                              ToolTip="Drag to resize" />

                <ContentControl x:Name="SurfaceHost" Grid.Column="1" Focusable="False" />
            </Grid>

            <!-- Modal overlays (settings dialog etc.) cover title bar + content -->
            <ContentControl x:Name="OverlayHost" Grid.Row="0" Grid.RowSpan="3" Focusable="False" />

            <!-- Toasts sit above everything, in the reference's bottom-right corner. -->
            <controls:ToastHost x:Name="Toasts" Grid.Row="0" Grid.RowSpan="3"
                                xmlns:controls="clr-namespace:JarvisCode.App.Controls" />

            <!-- Where mermaid runs. An engine view only has a container inside a
                 loaded visual tree, so the shared diagram renderer keeps a 1x1
                 transparent view here rather than off in a window of its own. -->
            <ContentControl x:Name="MermaidHost" Grid.Row="0" Focusable="False"
                            IsHitTestVisible="False" Width="1" Height="1"
                            HorizontalAlignment="Left" VerticalAlignment="Top" />
        </Grid>
    </Border>
</Window>
