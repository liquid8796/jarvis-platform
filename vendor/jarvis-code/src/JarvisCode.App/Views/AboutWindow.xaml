<Window x:Class="JarvisCode.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JarvisCode.App.Views"
        Title="About Jarvis"
        Width="320" Height="428"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnKeyDown"
        FontFamily="{StaticResource UiFontFamily}">
    <Border Background="{DynamicResource Bg100Brush}"
            BorderBrush="{DynamicResource BorderMidBrush}" BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <!-- The reference's own window is draggable everywhere but the buttons. -->
            <Border Background="Transparent" MouseLeftButtonDown="OnDragArea" />

            <Button x:Name="CloseButton" Style="{StaticResource IconButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                    FontFamily="{StaticResource IconFontFamily}" FontSize="10"
                    Content="&#xE8BB;" AutomationProperties.Name="Close"
                    Click="OnCloseClick" />

            <StackPanel VerticalAlignment="Top" Margin="0,64,0,0" HorizontalAlignment="Stretch">
                <views:SpinnerGlyph Width="84" Height="84" IsSpinning="False"
                                    HorizontalAlignment="Center" />

                <!--
                    The reference sets the name and "for Windows" in its serif face,
                    with only the word "for" italic and a non-breaking space after
                    the app name.
                -->
                <TextBlock x:Name="NameText" Margin="0,16,0,0" HorizontalAlignment="Center"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="24" FontWeight="Medium" TextAlignment="Center"
                           Foreground="{DynamicResource Text100Brush}">
                    <Run x:Name="AppNameRun" />
                    <Run x:Name="ForRun" FontStyle="Italic" Text=" for " />
                    <Run Text="Windows" />
                </TextBlock>

                <!--
                    The reference draws this as text that darkens on hover, not as a
                    button with a border: it is a line of metadata that happens to
                    copy itself.
                -->
                <Button x:Name="VersionButton" Margin="0,8,0,0" HorizontalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Padding="4,2"
                        Cursor="Hand" FontSize="13"
                        Foreground="{DynamicResource Text400Brush}"
                        Click="OnCopyVersionClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter x:Name="Body" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Text300Brush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock x:Name="BuiltText" Margin="0,4,0,0" HorizontalAlignment="Center"
                           FontSize="13" MinHeight="24"
                           Foreground="{DynamicResource Text400Brush}" />

                <StackPanel Margin="64,24,64,0">
                    <Button x:Name="HelpButton" Content="Help" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Click="OnHelpClick" />
                    <Button x:Name="SupportButton" Content="Get support" Margin="0,16,0,0"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Click="OnSupportClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
