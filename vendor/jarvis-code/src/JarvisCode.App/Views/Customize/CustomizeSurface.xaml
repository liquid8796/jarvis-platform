<UserControl x:Class="JarvisCode.App.Views.Customize.CustomizeSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFontFamily}"
             Background="{DynamicResource Bg100Brush}">
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto">
        <ContentControl x:Name="PageHost" Focusable="False"
                        MaxWidth="880" Margin="32,0" />
    </ScrollViewer>
</UserControl>
