<UserControl x:Class="JarvisCode.App.Views.Settings.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFontFamily}">
    <!-- Scrim over the whole window -->
    <Grid>
        <Border Background="#88000000" MouseLeftButtonDown="OnScrimClick" />

        <!-- The dialog card -->
        <Border Width="880" Height="620"
                MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Bg100Brush}"
                BorderBrush="{DynamicResource BorderMidBrush}" BorderThickness="1"
                CornerRadius="14"
                KeyboardNavigation.TabNavigation="Cycle">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.45" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsNavColumn" Width="192" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Nav -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Bg200Brush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0"
                        CornerRadius="14,0,0,14"
                        Padding="10,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="NavSearch"
                                 Style="{StaticResource SettingsSearchBox}"
                                 Margin="2,0,2,12"
                                 TextChanged="OnNavSearchChanged"
                                 AutomationProperties.Name="Search settings"
                                 ToolTip="Search settings" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <StackPanel x:Name="NavHost" />
                                <StackPanel x:Name="SearchResults" Visibility="Collapsed" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right"
                            Margin="0,10,12,0"
                            Click="OnCloseClick"
                            AutomationProperties.Name="Close settings">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                    </Button>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,20">
                        <ContentControl x:Name="PanelHost" Focusable="False" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
