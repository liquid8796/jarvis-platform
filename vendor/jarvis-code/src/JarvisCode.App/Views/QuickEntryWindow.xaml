<Window x:Class="JarvisCode.App.Views.QuickEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JarvisCode.App.Views"
        Title="Quick Entry"
        Width="606" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        FontFamily="{DynamicResource UiFontFamily}"
        Foreground="{DynamicResource Text100Brush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Border Background="{DynamicResource ClaudeBackgroundColorBrush}"
            BorderBrush="{DynamicResource BorderMidBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Margin="12"
            Padding="14,10,14,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Attached screenshots, which reach the pill by paste or by drop. -->
            <WrapPanel x:Name="ImageChips" Grid.Row="0" Grid.ColumnSpan="3"
                       Margin="0,0,0,8" Visibility="Collapsed" />

            <views:SpinnerGlyph Grid.Row="1" Width="18" Height="18" IsSpinning="False"
                                VerticalAlignment="Center" Margin="2,0,10,0" />

            <Grid Grid.Row="1" Grid.Column="1">
                <TextBox x:Name="PromptInput"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource ClaudeForegroundColorBrush}"
                         CaretBrush="{DynamicResource ClaudeForegroundColorBrush}"
                         SelectionBrush="{DynamicResource SelectionBrush}"
                         FontSize="14.5"
                         MinHeight="28" MaxHeight="150"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Center"
                         PreviewKeyDown="OnKeyDown"
                         TextChanged="OnTextChanged"
                         AutomationProperties.Name="Quick Entry prompt" />
                <TextBlock x:Name="PromptPlaceholder"
                           Text="Ask Jarvis anything…"
                           FontFamily="{Binding FontFamily, ElementName=PromptInput}"
                           FontSize="{Binding FontSize, ElementName=PromptInput}"
                           Margin="{Binding Padding, ElementName=PromptInput, Converter={StaticResource PlaceholderInset}}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ClaudeSecondaryColorBrush}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>

            <Button Grid.Row="1" Grid.Column="2" Width="30" Height="30" Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButton}" Padding="0"
                    Click="OnSubmitClick"
                    AutomationProperties.Name="Send to Jarvis">
                <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                           Foreground="{DynamicResource Oncolor100Brush}" />
            </Button>
        </Grid>
    </Border>
</Window>
