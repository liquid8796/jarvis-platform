<Window x:Class="JarvisCode.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="OnKeyDown"
        FontFamily="{StaticResource UiFontFamily}">
    <Border Background="{DynamicResource Bg100Brush}"
            BorderBrush="{DynamicResource BorderMidBrush}" BorderThickness="1"
            CornerRadius="12" Padding="18,16" MinWidth="340" MaxWidth="440">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.4" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Text100Brush}" />
            <TextBlock x:Name="MessageText" Margin="0,6,0,0" FontSize="12.5"
                       TextWrapping="Wrap" LineHeight="18"
                       Foreground="{DynamicResource Text300Brush}" />
            <!--
                The reference's alert dialog carries a children slot under the
                description: the permission consent uses it for the workspace path and
                a footnote, and every other caller leaves it empty.
            -->
            <TextBlock x:Name="SubjectText" Margin="0,12,0,0" FontSize="12.5"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       FontFamily="{DynamicResource MonoFontFamily}"
                       Foreground="{DynamicResource Text100Brush}" />
            <!--
                The uncommitted-changes confirm lists the paths it is about to
                discard in a scrolling <pre>, capped at the reference's max-h-40.
            -->
            <Border x:Name="PreformattedBox" Margin="0,12,0,0" Visibility="Collapsed"
                    CornerRadius="6" Padding="8" MaxHeight="160"
                    Background="{DynamicResource Tint1Brush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PreformattedText" FontSize="12"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFontFamily}"
                               Foreground="{DynamicResource Text300Brush}" />
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="FootnoteText" Margin="0,12,0,0" FontSize="11.5"
                       TextWrapping="Wrap" LineHeight="17" Visibility="Collapsed"
                       Foreground="{DynamicResource Text500Brush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Click="OnCancelClick" />
                <Button x:Name="MiddleButton" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="OnMiddleClick" />
                <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}"
                        Margin="8,0,0,0" Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
