<UserControl x:Class="JarvisCode.App.Views.Panels.ChangesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:JarvisCode.App.Infrastructure"
             xmlns:panels="clr-namespace:JarvisCode.App.Views.Panels">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />

        <!-- A side-by-side cell with no counterpart line: the reference hatches it.
             Mid-gray at low alpha reads on light and dark themes alike. -->
        <DrawingBrush x:Key="DiffBlankHatchBrush" TileMode="Tile"
                      Viewport="0,0,7,7" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M0,7 L7,0 M-1.75,1.75 L1.75,-1.75 M5.25,8.75 L8.75,5.25">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2E808080" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- One diff line: number gutter · change marker · code. -->
        <DataTemplate DataType="{x:Type panels:DiffLineRow}">
            <Grid x:Name="Row" Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Annotate" Click="OnLineAnnotateClick" />
                        <MenuItem Header="Add comment" Click="OnLineCommentClick" />
                        <MenuItem Header="Remove annotation" Click="OnLineRemoveAnnotationClick" Visibility="{Binding IsAnnotated, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" TextAlignment="Right" Margin="0,0,9,0"
                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                           Foreground="{DynamicResource Text500Brush}" />
                <TextBlock x:Name="Marker" Grid.Column="1" Text="{Binding Marker}"
                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                           Foreground="{DynamicResource Text500Brush}" />
                <TextBlock x:Name="Code" Grid.Column="2" Text="{Binding Text}"
                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                           Foreground="{DynamicResource Text200Brush}"
                           TextWrapping="Wrap" />
                <Border Width="3" HorizontalAlignment="Left" Grid.ColumnSpan="3" Background="{DynamicResource AccentBrush}"
                        ToolTip="Annotation" Visibility="{Binding IsAnnotated, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource DiffAddedBgBrush}" />
                    <Setter TargetName="Marker" Property="Foreground" Value="{DynamicResource Success100Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource DiffRemovedBgBrush}" />
                    <Setter TargetName="Marker" Property="Foreground" Value="{DynamicResource Danger100Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Hunk">
                    <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource Text500Brush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The fold: "N unmodified lines" with a chevron pointing at the hidden run. -->
        <DataTemplate DataType="{x:Type panels:DiffCollapseRow}">
            <Button Style="{StaticResource RowButton}" Padding="6,3"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ExpandCommand}"
                    IsEnabled="{Binding CanExpand}"
                    AutomationProperties.Name="{Binding Count, StringFormat={}{0} unmodified lines}">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="FoldChevron" Width="10" Height="10" Stretch="Uniform"
                          Data="{StaticResource DisclosureDownGlyph}"
                          Stroke="{DynamicResource Text500Brush}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center" Margin="4,0,9,0" />
                    <TextBlock Text="{Binding Count, StringFormat={}{0} unmodified lines}"
                               FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text500Brush}" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsTop}" Value="True">
                    <Setter TargetName="FoldChevron" Property="Data" Value="{StaticResource DisclosureUpGlyph}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One side-by-side row: old line left, new line right. -->
        <DataTemplate DataType="{x:Type panels:DiffPairRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="LeftSide" Background="Transparent">
                    <Grid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext.LeftSource, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Annotate" Click="OnLineAnnotateClick" />
                            <MenuItem Header="Add comment" Click="OnLineCommentClick" />
                            <MenuItem Header="Remove annotation" Click="OnLineRemoveAnnotationClick" Visibility="{Binding IsAnnotated, Converter={StaticResource BoolToVis}}" />
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LeftNumber}" TextAlignment="Right" Margin="0,0,8,0"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                               Foreground="{DynamicResource Text500Brush}" />
                    <TextBlock x:Name="LeftMarker" Grid.Column="1" Text="{Binding LeftMarker}"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                               Foreground="{DynamicResource Text500Brush}" />
                    <TextBlock x:Name="LeftText" Grid.Column="2" Text="{Binding LeftText}"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                               Foreground="{DynamicResource Text200Brush}"
                               TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="RightSide" Grid.Column="2" Background="Transparent">
                    <Grid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext.RightSource, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Annotate" Click="OnLineAnnotateClick" />
                            <MenuItem Header="Add comment" Click="OnLineCommentClick" />
                            <MenuItem Header="Remove annotation" Click="OnLineRemoveAnnotationClick" Visibility="{Binding IsAnnotated, Converter={StaticResource BoolToVis}}" />
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RightNumber}" TextAlignment="Right" Margin="0,0,8,0"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                               Foreground="{DynamicResource Text500Brush}" />
                    <TextBlock x:Name="RightMarker" Grid.Column="1" Text="{Binding RightMarker}"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                               Foreground="{DynamicResource Text500Brush}" />
                    <TextBlock Grid.Column="2" Text="{Binding RightText}"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                               Foreground="{DynamicResource Text200Brush}"
                               TextWrapping="Wrap" />
                </Grid>
                <Border Grid.Column="0" Width="3" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                        ToolTip="Annotation" Visibility="{Binding LeftSource.IsAnnotated, Converter={StaticResource BoolToVis}}" />
                <Border Grid.Column="2" Width="3" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                        ToolTip="Annotation" Visibility="{Binding RightSource.IsAnnotated, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding LeftKind}" Value="Removed">
                    <Setter TargetName="LeftSide" Property="Background" Value="{DynamicResource DiffRemovedBgBrush}" />
                    <Setter TargetName="LeftMarker" Property="Foreground" Value="{DynamicResource Danger100Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LeftKind}" Value="Blank">
                    <Setter TargetName="LeftSide" Property="Background" Value="{StaticResource DiffBlankHatchBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LeftKind}" Value="Hunk">
                    <Setter TargetName="LeftText" Property="Foreground" Value="{DynamicResource Text500Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RightKind}" Value="Added">
                    <Setter TargetName="RightSide" Property="Background" Value="{DynamicResource DiffAddedBgBrush}" />
                    <Setter TargetName="RightMarker" Property="Foreground" Value="{DynamicResource Success100Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RightKind}" Value="Blank">
                    <Setter TargetName="RightSide" Property="Background" Value="{StaticResource DiffBlankHatchBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One changed file: disclosure row, then its diff when open. -->
        <DataTemplate DataType="{x:Type panels:ChangedFileRow}">
            <StackPanel Margin="0,0,0,1">
                <Button Style="{StaticResource RowButton}" Padding="8,4"
                        HorizontalContentAlignment="Stretch"
                        Visibility="{Binding ShowFiles, RelativeSource={RelativeSource AncestorType={x:Type panels:ChangesPanel}}, Converter={StaticResource BoolToVis}}"
                        Command="{Binding ToggleCommand}"
                        AutomationProperties.Name="{Binding Path}">
                    <Button.ContextMenu>
                        <ContextMenu Opened="OnFileRowMenuOpened">
                            <MenuItem x:Name="OpenInItem" Header="Open" Click="OnFileRowOpenClick" />
                            <MenuItem Header="Open diff in editor" Click="OnFileRowEditorDiffClick" />
                            <MenuItem Header="Close editor diffs" Click="OnCloseEditorDiffsClick" />
                            <MenuItem Header="Copy path" Click="OnFileRowCopyPathClick" />
                            <MenuItem Header="Attach as context" Click="OnFileRowAttachClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <!-- chevron · type icon · name · path · +adds −dels, all left-aligned. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MaxWidth="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="Chevron" Width="11" Height="11" Stretch="Uniform"
                              Data="{StaticResource DisclosureRightGlyph}"
                              Stroke="{DynamicResource Text500Brush}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,7,0" />
                        <Path x:Name="TypeIcon" Grid.Column="1" Width="12" Height="12" Stretch="Uniform"
                              Data="{StaticResource FileGlyph}"
                              Stroke="{DynamicResource Text500Brush}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12.5"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text100Brush}" />
                        <TextBlock Grid.Column="3" Text="{Binding Directory}" FontSize="11.5"
                                   Margin="7,0,10,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Text500Brush}" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Added}" FontSize="11.5"
                                       Foreground="{DynamicResource Success100Brush}" />
                            <TextBlock Text="{Binding Removed}" FontSize="11.5" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Danger100Brush}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource Bg100Brush}"
                        CornerRadius="6" Margin="0,2,0,6" Padding="0,6">
                    <!-- Long lines wrap in both layouts, so rows never scroll sideways
                         and the two halves of a pair always share one height. -->
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Lines}"
                                      Visibility="{Binding IsSideBySide, RelativeSource={RelativeSource AncestorType={x:Type panels:ChangesPanel}}, Converter={StaticResource InverseBoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Pairs}"
                                      Visibility="{Binding IsSideBySide, RelativeSource={RelativeSource AncestorType={x:Type panels:ChangesPanel}}, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Data" Value="{StaticResource DisclosureDownGlyph}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCodeFile}" Value="True">
                    <Setter TargetName="TypeIcon" Property="Data" Value="{StaticResource CodeFileGlyph}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The reference's findings stepper: the status line, the two arrows once there is
            more than one finding, then Apply fixes (or Re-run review, once they are all
            applied) and Dismiss.
        -->
        <Border x:Name="FindingsBar" Grid.Row="1" Visibility="Collapsed"
                Margin="6,0,6,6" Padding="8,4" CornerRadius="6"
                Background="{DynamicResource Bg100Brush}" SizeChanged="OnFindingsBarSizeChanged">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="FindingsStatus" FontSize="12" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource Text400Brush}" />
                <Button x:Name="PreviousFindingButton" Style="{StaticResource PanelActionButton}"
                        Margin="8,0,0,0" Click="OnPreviousFindingClick"
                        AutomationProperties.Name="Previous finding" ToolTip="Previous finding">
                    <Path Style="{StaticResource PanelSmallGlyph}" Data="{StaticResource ArrowLeftGlyph}" />
                </Button>
                <Button x:Name="NextFindingButton" Style="{StaticResource PanelActionButton}"
                        Click="OnNextFindingClick"
                        AutomationProperties.Name="Next finding" ToolTip="Next finding">
                    <Path Style="{StaticResource PanelSmallGlyph}" Data="{StaticResource ArrowRightGlyph}" />
                </Button>
                <Button x:Name="ApplyFixesButton" Content="Apply fixes" Margin="10,0,0,0"
                        Padding="8,2" Style="{StaticResource SecondaryButton}"
                        Click="OnApplyFixesClick" />
                <Button x:Name="RerunReviewButton" Content="Re-run review" Margin="10,0,0,0"
                        Padding="8,2" Style="{StaticResource SecondaryButton}"
                        Visibility="Collapsed" Click="OnRerunReviewClick" />
                <Button x:Name="DismissFindingsButton" Content="Dismiss" Margin="6,0,0,0"
                        Padding="8,2" Style="{StaticResource GhostButton}"
                        Click="OnDismissFindingsClick" />
                <Button x:Name="CompactReviewActionsButton" Content="…" Style="{StaticResource PanelActionButton}"
                        Visibility="Collapsed" Click="OnCompactReviewActionsClick" ToolTip="Review actions" AutomationProperties.Name="Review actions" />
            </StackPanel>
        </Border>

        <!-- Breadcrumb: the compare target, e.g. master › working tree -->
        <Button x:Name="ScopeButton" Style="{StaticResource RowButton}"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="6,0,0,0" Padding="6,4"
                Click="OnScopeClick"
                AutomationProperties.Name="Compare target">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource PanelSmallGlyph}" Data="{StaticResource FolderGlyph}"
                      Stroke="{DynamicResource Text400Brush}" Margin="0,0,7,0" />
                <TextBlock x:Name="BranchText" Style="{StaticResource PanelTitleText}" Text="—" />
                <TextBlock Style="{StaticResource PanelMutedText}" Text="›" Margin="6,0,6,0" />
                <TextBlock x:Name="ScopeText" Style="{StaticResource PanelMutedText}" Text="working tree" />
            </StackPanel>
        </Button>

        <Button x:Name="ExpandDiffButton" Style="{StaticResource PanelActionButton}"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,110,0"
                Click="OnExpandDiffClick"
                AutomationProperties.Name="Expand changes" ToolTip="Expand changes">
            <Path Style="{StaticResource PanelSmallGlyph}" Data="{StaticResource ExpandGlyph}" />
        </Button>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="FilesScroll" VerticalScrollBarVisibility="Auto" Padding="6,0,6,10">
                <ItemsControl x:Name="FileList" />
            </ScrollViewer>
            <TextBlock x:Name="EmptyText"
                       Visibility="Collapsed"
                       FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="280"
                       Foreground="{DynamicResource Text500Brush}" />
        </Grid>
    </Grid>
</UserControl>
