<UserControl x:Class="JarvisCode.App.Views.Panels.BrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JarvisCode.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab bar -->
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      Margin="8,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="Tabs">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Style="{StaticResource PanelActionButton}" Click="OnNewTabClick"
                        AutomationProperties.Name="New tab" ToolTip="New tab">
                    <Path Style="{StaticResource PanelSmallGlyph}" Data="{StaticResource PlusGlyph}" />
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Navigation controls + address bar + toolbar actions -->
        <Grid Grid.Row="1" Margin="8,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource PanelActionButton}" Click="OnBackClick"
                        AutomationProperties.Name="Back" ToolTip="Back">
                    <Path Style="{StaticResource PanelSmallGlyph}" Data="{StaticResource ArrowLeftGlyph}" />
                </Button>
                <Button x:Name="ForwardButton" Style="{StaticResource PanelActionButton}" Click="OnForwardClick"
                        AutomationProperties.Name="Forward" ToolTip="Forward">
                    <Path Style="{StaticResource PanelSmallGlyph}" Data="{StaticResource ArrowRightGlyph}" />
                </Button>
                <Button x:Name="ReloadButton" Style="{StaticResource PanelActionButton}" Click="OnReloadClick"
                        AutomationProperties.Name="Reload" ToolTip="Reload">
                    <Path Style="{StaticResource PanelSmallGlyph}" Data="{StaticResource ReloadGlyph}" />
                </Button>
            </StackPanel>

            <TextBox x:Name="AddressBox" Grid.Column="1" Margin="6,0,6,0"
                     Style="{StaticResource PanelAddressBox}"
                     controls:PlaceholderText.Text="Type a URL"
                     KeyDown="OnAddressKeyDown"
                     AutomationProperties.Name="Address" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="PickButton" Style="{StaticResource PanelActionButton}" Click="OnPickClick"
                              AutomationProperties.Name="Select element" ToolTip="Select element (attaches it as context)">
                    <Path Style="{StaticResource PanelSmallGlyphFilled}" Data="{StaticResource PointerGlyph}" />
                </ToggleButton>
                <ToggleButton x:Name="AnnotateButton" Style="{StaticResource PanelActionButton}" Click="OnAnnotateClick"
                              AutomationProperties.Name="Annotate" ToolTip="Annotate">
                    <Path Style="{StaticResource PanelSmallGlyph}" Data="{StaticResource PenGlyph}" />
                </ToggleButton>
                <Button x:Name="ClearButton" Style="{StaticResource PanelActionButton}" Click="OnClearClick"
                        AutomationProperties.Name="Clear browsing data" ToolTip="Clear browsing data">
                    <Path Style="{StaticResource PanelSmallGlyph}" Data="{StaticResource TrashGlyph}" />
                </Button>
                <Button x:Name="MenuButton" Style="{StaticResource PanelActionButton}" Click="OnMenuClick"
                        AutomationProperties.Name="Browser menu" ToolTip="Browser options">
                    <Path Style="{StaticResource PanelSmallGlyphFilled}" Data="{StaticResource KebabGlyph}" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Border x:Name="WebHostBorder" CornerRadius="0,0,10,10" ClipToBounds="True" Background="#FFFFFF">
                <Grid x:Name="WebHost" />
            </Border>

            <!-- The pencil's drawing surface, over the page it captured. -->
            <Grid x:Name="AnnotationHost" Visibility="Collapsed" />

            <!-- Empty state: "Browse and verify" + the dev-server detect flow. -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="340">
                <Path Style="{StaticResource PanelGlyph}" Data="{StaticResource GlobeGlyph}"
                      Width="30" Height="30" StrokeThickness="1.4"
                      Stroke="{DynamicResource Text400Brush}"
                      HorizontalAlignment="Center" />
                <TextBlock Text="Browse and verify" FontSize="13.5" FontWeight="Medium"
                           Margin="0,14,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Text200Brush}" />
                <TextBlock Text="Jarvis can browse, click, and screenshot here. Enter a URL above to start."
                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource Text500Brush}" />
                <ContentControl x:Name="DetectArea" Margin="0,18,0,0" Focusable="False" />
            </StackPanel>

            <!-- Dev-server state: "Setting up preview" / "Dev server failed to start". -->
            <StackPanel x:Name="ServerState" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <TextBlock x:Name="ServerStateTitle" FontSize="13.5" FontWeight="Medium"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text200Brush}" />
                <TextBlock x:Name="ServerStateBody" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource Text500Brush}" />
                <Border x:Name="ServerLogBorder" Visibility="Collapsed" Margin="0,12,0,0"
                        Background="{DynamicResource Bg100Brush}" CornerRadius="8"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                        MaxHeight="180">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                        <TextBox x:Name="ServerLogBox" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11" TextWrapping="Wrap"
                                 Foreground="{DynamicResource Text300Brush}" />
                    </ScrollViewer>
                </Border>
                <StackPanel x:Name="ServerStateButtons" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,14,0,0" />
                <TextBlock x:Name="ServerStateNote" Visibility="Collapsed"
                           FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource Text500Brush}" />
            </StackPanel>

            <!-- Confirm overlay (clear browsing data, auto verify). -->
            <Border x:Name="ConfirmOverlay" Visibility="Collapsed" Background="#66000000">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                        Background="{DynamicResource Bg000Brush}"
                        BorderBrush="{DynamicResource BorderMidBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="18,16">
                    <StackPanel>
                        <TextBlock x:Name="ConfirmTitle" FontSize="13.5" FontWeight="Medium"
                                   Foreground="{DynamicResource Text100Brush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ConfirmBody" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text400Brush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="ConfirmCancelButton" Style="{StaticResource RowButton}" Padding="10,5"
                                    Click="OnConfirmCancel" AutomationProperties.Name="Cancel">
                                <TextBlock Text="Cancel" FontSize="12" Foreground="{DynamicResource Text300Brush}" />
                            </Button>
                            <Button x:Name="ConfirmPrimaryButton" Style="{StaticResource RowButton}" Padding="10,5"
                                    Margin="8,0,0,0" Click="OnConfirmPrimary">
                                <TextBlock x:Name="ConfirmPrimaryText" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource Text100Brush}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Transient confirmation toast. -->
            <Border x:Name="Toast" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,16" Padding="12,7"
                    CornerRadius="8"
                    Background="{DynamicResource Bg000Brush}"
                    BorderBrush="{DynamicResource BorderMidBrush}" BorderThickness="1">
                <TextBlock x:Name="ToastText" FontSize="12"
                           Foreground="{DynamicResource Text200Brush}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
