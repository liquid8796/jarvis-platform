<Window x:Class="JarvisCode.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="OnKeyDown"
        FontFamily="{StaticResource UiFontFamily}">
    <Border Background="{DynamicResource Bg100Brush}"
            BorderBrush="{DynamicResource BorderMidBrush}" BorderThickness="1"
            CornerRadius="12" Padding="18,16" MinWidth="380" MaxWidth="460">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.4" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <!--
                    The reference passes a dialog "type"; on Windows that draws the
                    system icon beside the message. Ours is a glyph in the theme's
                    own semantic colour, so a warning still reads as one.
                -->
                <TextBlock x:Name="TypeGlyph" FontFamily="{StaticResource IconFontFamily}"
                           FontSize="16" Margin="0,1,10,0" VerticalAlignment="Top"
                           Visibility="Collapsed" />
                <TextBlock x:Name="MessageText" FontSize="14" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxWidth="380"
                           Foreground="{DynamicResource Text100Brush}" />
            </StackPanel>
            <TextBlock x:Name="DetailText" Margin="0,6,0,0" FontSize="12.5"
                       TextWrapping="Wrap" LineHeight="18" Visibility="Collapsed"
                       Foreground="{DynamicResource Text300Brush}" />
            <StackPanel x:Name="Buttons" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,18,0,0" />
        </StackPanel>
    </Border>
</Window>
