<Window x:Class="JarvisCode.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}">
    <Border Background="{DynamicResource Bg100Brush}"
            BorderBrush="{DynamicResource BorderMidBrush}" BorderThickness="1"
            CornerRadius="12" Padding="18,14" MinWidth="340">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.4" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text100Brush}" Margin="0,0,0,10" />
            <TextBox x:Name="ValueBox" Style="{StaticResource InputTextBox}"
                     PreviewKeyDown="OnKeyDown"
                     AutomationProperties.Name="Value" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancelClick" />
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" Click="OnOkClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
