{
  "manifest_version": 3,
  "name": "Jarvis Browser",
  "version": "1.1.0",
  "description": "Connects your browser to Jarvis Code so the agent can read pages, navigate, interact with tabs you allow, and inspect console, network and screenshots while verifying a web app.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "nativeMessaging",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Jarvis Browser"
  }
}
