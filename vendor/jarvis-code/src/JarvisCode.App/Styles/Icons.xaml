    <!-- Stroked glyph: inherits the hosting button's Foreground so hover/active states carry. -->
    <Style x:Key="PanelGlyph" TargetType="Path">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
    </Style>

    <Style x:Key="PanelGlyphFilled" TargetType="Path" BasedOn="{StaticResource PanelGlyph}">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Fill"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
    </Style>

    <!--
        Panel toggle: a square control at the height the reference's trailing cluster pins
        (a 26px control height) on its `gap-1` 4px pitch. The active one sits on a blue
        chip drawn from the interface accent.
    -->
    <Style x:Key="PanelToggle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Foreground" Value="{DynamicResource Text400Brush}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource PanelToggleActiveBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PanelToggleActiveFgBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PanelIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Foreground" Value="{DynamicResource Text400Brush}" />
    </Style>

</ResourceDictionary>
