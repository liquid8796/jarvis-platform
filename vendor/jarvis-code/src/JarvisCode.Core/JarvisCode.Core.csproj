<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.11" />
    <PackageReference Include="Jint" Version="4.16.1" />
    <!-- PDF page text and rendering ship with the app; no external CLI is required. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="153.0.7999" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JarvisCode.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Mcp\SchemaMetaValidator.js" />
    <Content Include="ThirdParty\Ajv\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty\CrossSpawn\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Pdfium\**\*" Link="ThirdParty\Pdfium\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
