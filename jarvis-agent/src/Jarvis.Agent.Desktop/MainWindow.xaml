<Window x:Class="Jarvis.Agent.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Jarvis Agent" Icon="/Jarvis.Agent.Desktop;component/Assets/JarvisAgent.ico" Width="1160" Height="820" MinWidth="870" MinHeight="650" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#11151F" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><DockPanel Margin="23,29,20,24">
<StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal"><Image Source="/Jarvis.Agent.Desktop;component/Assets/JarvisAgent.png" Width="44" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Jarvis Agent logo"/><StackPanel Margin="12,0,0,0"><TextBlock Text="Jarvis" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="PERSONAL AGENT" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel><TextBlock Text="WORKSPACE" Margin="2,43,0,14" Foreground="#69738D" FontSize="10"/><Button Content="Connection center" Command="{Binding ConnectionTabCommand}" Padding="12" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
<Button Content="Tool permissions" Command="{Binding PermissionsTabCommand}" Padding="12" HorizontalContentAlignment="Left"/><TextBlock Text="Your computer stays yours." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="13,18,10,0"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><Border BorderBrush="#29473E" BorderThickness="1" CornerRadius="10" Padding="13" Background="#11251F"><StackPanel><TextBlock Text="Local tool permissions" Foreground="#8CD8B7" FontSize="11"/><TextBlock Text="You choose which tools can run without asking again." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/></StackPanel></Border><TextBlock Text="Windows desktop · v1.0.24" Foreground="#68738D" FontSize="10" Margin="0,18,0,0"/><TextBlock Text="Ctrl + Alt + Pause to stop" Foreground="#929CB4" FontSize="10" Margin="0,6,0,0"/></StackPanel><Grid/>
</DockPanel></Border>
<DockPanel Grid.Column="1"><Border DockPanel.Dock="Top" Height="72" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><Grid Margin="30,0"><TextBlock Text="Agent settings" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Border HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="#344138" BorderThickness="1" CornerRadius="13" Padding="12,5"><TextBlock Text="{Binding Status}" Foreground="#8CD8B7" FontSize="10"/></Border></Grid></Border>
<TabControl x:Name="SettingsTabs" SelectedIndex="{Binding SelectedTab}" Margin="16,12,16,0">
<TabItem Header="Connection center"><ScrollViewer><StackPanel Margin="14,15,14,25"><TextBlock Text="Your workspace. Connected." FontSize="29" FontWeight="SemiBold"/><TextBlock Text="A secure bridge between your AI tools and the computer you control." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,23"/>
<Border CornerRadius="15" BorderBrush="#41335F" BorderThickness="1" Padding="23,20" Margin="0,0,0,22"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#24203C"/><GradientStop Color="#16202B" Offset="1"/></LinearGradientBrush></Border.Background><Grid><StackPanel><TextBlock Text="LOCAL CONTROL" FontSize="9" Foreground="#BBA2EF"/><TextBlock Text="{Binding Control}" FontSize="22" Margin="0,7,0,8"/><TextBlock Text="No automatic expiry. Pause, disconnect or exit to stop local control." Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Arm control" Command="{Binding ArmCommand}" Style="{StaticResource Primary}" Margin="10,0"/><Button Content="Pause now" Command="{Binding PauseCommand}" Background="#362432" Foreground="#FFA5B7"/></StackPanel></Grid></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Connection details" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Use the values from Jarvis Control → Enroll device." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,4"/>
<TextBlock Text="SERVER URL" Style="{StaticResource Caption}"/><TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Server URL"/>
<TextBlock Text="DEVICE ID" Style="{StaticResource Caption}"/><TextBox Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Device ID"/>
<TextBlock Text="ENROLLMENT TOKEN" Style="{StaticResource Caption}"/><PasswordBox x:Name="TokenBox" PasswordChanged="TokenChanged" AutomationProperties.Name="Enrollment token"/>
<TextBlock Text="PRIMARY WORKING DIRECTORY" Style="{StaticResource Caption}"/><DockPanel><Button Content="…" Command="{Binding BrowseCommand}" DockPanel.Dock="Right" Margin="7,0,0,0" ToolTip="Select one or more project directories"/><TextBox Text="{Binding Workspace, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Workspace directory"/></DockPanel>
<TextBlock Text="ADDITIONAL PROJECT DIRECTORIES" Style="{StaticResource Caption}"/>
<ListBox ItemsSource="{Binding AdditionalDirectories}" SelectedItem="{Binding SelectedDirectory}" Height="86" Background="#0E121B" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Additional project directories"/>
<WrapPanel Margin="0,9,0,0"><Button Content="Add folders" Command="{Binding BrowseCommand}" Padding="10,7" Margin="0,0,7,0"/><Button Content="Make primary" Command="{Binding MakePrimaryDirectoryCommand}" Padding="10,7" Margin="0,0,7,0"/><Button Content="Remove" Command="{Binding RemoveDirectoryCommand}" Padding="10,7"/></WrapPanel>
<TextBlock Text="Choose multiple folders with Ctrl/Shift in the picker. Changes apply on the next connection. All tools may use paths outside these folders. Relative paths start in the primary folder." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,9,0,0"/>
<CheckBox Content="Allow HTTP for localhost development only" IsChecked="{Binding AllowLoopbackHttp}" FontSize="10"/>
<Button Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}" Style="{StaticResource Primary}" Margin="0,22,0,12"/>
<TextBlock Text="Tokens are encrypted with Windows DPAPI for this user. The agent never starts remotely or elevates itself." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
<TextBlock Text="{Binding Error}" Foreground="#FFA5B7" FontSize="11" TextWrapping="Wrap" Margin="0,13,0,0"/>
</StackPanel></Border>
<StackPanel Grid.Column="2"><Border Style="{StaticResource Card}" Padding="20"><StackPanel><Grid><TextBlock Text="Browser bridge" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="↗" HorizontalAlignment="Right" Foreground="#BBA2EF" FontSize="18"/></Grid><TextBlock Text="Connect Chrome, Edge or Cốc Cốc using the separate Jarvis Agent extension." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,14"/><Button Content="Set up browser integration" Command="{Binding BrowserCommand}"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0"><StackPanel><Grid><TextBlock Text="Live activity" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="●" Foreground="#9775EC" HorizontalAlignment="Right"/></Grid><TextBlock Text="Connection and tool outcomes · no sensitive payloads" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,15"/><ScrollViewer Height="225"><ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#252B3B" BorderThickness="0,0,0,1" Padding="0,9"><StackPanel><TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border>
</StackPanel></Grid>
<Expander Header="Installed tool inventory" Margin="0,22,0,0" Foreground="{StaticResource Muted}"><Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="{Binding ToolCount, StringFormat={}{0} registered tools}" FontSize="12" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Tools}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Padding="8,4" Margin="0,0,8,8" CornerRadius="6" Background="#252136"><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10" Foreground="#C1B0ED"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Expander>
<TextBlock Text="Closing or minimizing hides this window in the system tray. Use the tray’s Exit command to stop Jarvis Agent." TextWrapping="Wrap" FontSize="10" Foreground="#68738D" Margin="0,20,0,0"/>
</StackPanel></ScrollViewer>
</TabItem>
<TabItem Header="Tool permissions">
<Grid Margin="14,18,14,18" DataContext="{Binding Permissions}">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0">
<TextBlock Text="Tool permissions" FontSize="28" FontWeight="SemiBold"/>
<TextBlock Text="Preapprove the tools you trust. Your choice, saved on this computer." Foreground="{StaticResource Muted}" Margin="0,8,0,16" TextWrapping="Wrap"/>
<Border Background="#24203C" BorderBrush="#41335F" BorderThickness="1" CornerRadius="12" Padding="16">
<StackPanel><TextBlock Text="Full permission = no repeated Jarvis approval" FontWeight="SemiBold" Foreground="#C4AEFC"/>
<TextBlock Text="Selected tools can access files outside project folders and act with your Windows account permissions. Arm control is still required; Pause stops control. This does not elevate to Administrator or override browser/Windows policy." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
</StackPanel></Border>
</StackPanel>
<Grid Grid.Row="1" Margin="0,16,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search tool permissions" ToolTip="Search by name, category or tool ID" Margin="0,0,15,0"/>
<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding SelectionSummary}"/><TextBlock Text="{Binding SavedSummary}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
</Grid>
<WrapPanel Grid.Row="2" Margin="0,0,0,12">
<Button Content="Select all tools" Command="{Binding SelectAllCommand}" Padding="12,9" Margin="0,0,8,4"/>
<Button Content="Clear all" Command="{Binding ClearAllCommand}" Padding="12,9" Margin="0,0,8,4"/>
<Button Content="Reset changes" Command="{Binding ResetCommand}" Padding="12,9" Margin="0,0,8,4"/>
<Button Content="Save permissions" Command="{Binding SaveCommand}" Style="{StaticResource Primary}" Padding="14,9" Margin="0,0,0,4"/>
</WrapPanel>
<ListBox Grid.Row="3" ItemsSource="{Binding FilteredTools}" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Tool permission list">
<ListBox.ItemTemplate><DataTemplate><Border Padding="12,10" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,12,0" ToolTip="{Binding Description}"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" FontFamily="Consolas"/><TextBlock Text="{Binding Category}" Foreground="#BBA2EF" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="{Binding DefaultBehavior}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
<CheckBox Grid.Column="1" Content="Full permission" IsChecked="{Binding FullPermission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0" AutomationProperties.Name="{Binding Name}"/>
</Grid></Border></DataTemplate></ListBox.ItemTemplate>
</ListBox>
<StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="{Binding Status}" Foreground="#8CD8B7" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding Error}" Foreground="#FFA5B7" TextWrapping="Wrap" Margin="0,5,0,0"/>
<TextBlock Text="Select all applies to the current inventory, including filtered-out tools. Newly added tools are not automatically granted. Questions requesting actual task input still require an answer." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10" Margin="0,9,0,0"/>
</StackPanel>
</Grid>
</TabItem></TabControl>
</DockPanel></Grid></Window>
