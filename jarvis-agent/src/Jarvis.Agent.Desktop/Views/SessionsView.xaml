<UserControl x:Class="Jarvis.Agent.Desktop.Views.SessionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.Name="Local agent sessions">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/SessionControls.xaml"/></ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="VisibleIfTrue"/>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.InputBindings><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/></UserControl.InputBindings>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="14,24,14,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="260"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Sessions" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
      <TextBlock Text="Independent chats. One local agent. Shared work stays visible." Style="{StaticResource SessionHint}" Margin="0,8,0,16"/>
      <Border Style="{StaticResource SessionCard}" Padding="16"><StackPanel><TextBlock Text="{Binding Summary}" Style="{StaticResource SessionBody}" FontWeight="SemiBold"/><TextBlock Text="{Binding Updated}" Style="{StaticResource SessionHint}" Margin="0,6,0,0"/></StackPanel></Border>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,16,0,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SessionInput}" Margin="0,0,12,0" AutomationProperties.Name="Filter sessions by name, workspace or ID" ToolTip="Search name, workspace or session ID"/>
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SessionButton}" ToolTip="Refresh sessions. F5"/>
      </Grid>
      <CheckBox Content="Show closed sessions" IsChecked="{Binding ShowClosed}" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
    </StackPanel>
    <Grid Grid.Row="2" MinHeight="110">
      <ListBox ItemContainerStyle="{StaticResource SessionRow}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Session activity list">
        <ListBox.ItemTemplate><DataTemplate>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{Binding Label}" Style="{StaticResource SessionBody}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Workspace}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Workspace}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding WorkSummary}" Style="{StaticResource SessionHint}" Margin="0,7,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Padding="10,5"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Text}" FontSize="12" FontWeight="SemiBold"/></Border>
                <TextBlock Text="{Binding Unread, StringFormat={}{0} unread events}" Style="{StaticResource SessionHint}" Margin="0,10,0,0" TextAlignment="Right"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="24" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleIfTrue}}">
        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource SessionBody}"/><TextBlock Text="Metadata and coordination events only. Session handles and transcripts are never displayed here." Style="{StaticResource SessionHint}" Margin="0,10,0,0"/></StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="3" Style="{StaticResource SessionCard}" Padding="16" Margin="0,12,0,0" Visibility="{Binding HasSelection, Converter={StaticResource VisibleIfTrue}}">
      <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Selected.Label}" Style="{StaticResource SessionBody}" FontWeight="SemiBold"/><TextBlock Text="{Binding Selected.WorkspaceRevision}" Style="{StaticResource SessionHint}" Margin="0,4,0,0"/></StackPanel>
          <WrapPanel Grid.Column="1"><Button Content="Stop work" Command="{Binding StopCommand}" Style="{StaticResource SessionButton}" Margin="0,0,8,0" Padding="12,9"/><Button Content="Close session" Command="{Binding CloseCommand}" Style="{StaticResource SessionButton}" Foreground="{DynamicResource Danger}" Padding="12,9"/></WrapPanel>
        </Grid>
        <Expander Header="Identity and held resources" Foreground="{DynamicResource Text}" Margin="0,12,0,0" AutomationProperties.Name="Selected session details">
          <ScrollViewer MaxHeight="180" Margin="0,8,0,0"><StackPanel>
            <TextBlock Text="{Binding Selected.SessionId}" Style="{StaticResource SessionBody}" FontFamily="Consolas"/>
            <TextBlock Text="{Binding Selected.Workspace}" Style="{StaticResource SessionHint}" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding Selected.Parent, StringFormat=Parent: {0}}" Style="{StaticResource SessionHint}" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding Selected.LastActive, StringFormat=Last active: {0}}" Style="{StaticResource SessionHint}" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding Selected.TaskQueue}" Style="{StaticResource SessionHint}" Margin="0,8,0,0"/>
            <TextBlock Text="HELD" Style="{StaticResource SessionHint}" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBlock Text="{Binding Selected.HeldResources}" Style="{StaticResource SessionBody}" FontFamily="Consolas" FontSize="12"/>
            <TextBlock Text="WAITING FOR" Style="{StaticResource SessionHint}" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBlock Text="{Binding Selected.WaitingResources}" Style="{StaticResource SessionBody}" FontFamily="Consolas" FontSize="12"/>
          </StackPanel></ScrollViewer>
        </Expander>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="4" Margin="0,12,0,0">
      <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource SessionHint}" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{Binding Error}" Style="{StaticResource SessionError}"/>
      <TextBlock Text="Stop work cancels only the selected session. Close is permanent for its handle. To stop every session, use the separate Pause control." Style="{StaticResource SessionHint}" Margin="0,8,0,0"/>
    </StackPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
