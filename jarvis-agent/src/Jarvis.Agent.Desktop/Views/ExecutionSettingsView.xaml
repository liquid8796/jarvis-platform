<UserControl x:Class="Jarvis.Agent.Desktop.Views.ExecutionSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.Name="Execution limits settings">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/SessionControls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <UserControl.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/></UserControl.InputBindings>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,24,14,24">
      <TextBlock Text="Execution limits" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
      <TextBlock Text="Give every chat room to work. Keep shared resources coordinated." Style="{StaticResource SessionHint}" Margin="0,8,0,24"/>
      <Border Style="{StaticResource SessionCard}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,24,0">
            <TextBlock Text="CONCURRENT TOOL CALLS" Style="{StaticResource SessionHint}" FontWeight="SemiBold"/>
            <TextBlock Text="One agent. Multiple independent chats." Style="{StaticResource SessionBody}" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,8"/>
            <TextBlock Text="{Binding ConcurrentCalls.Hint}" Style="{StaticResource SessionHint}"/>
            <TextBlock Text="Default: 5 · positive whole numbers · no restart required" Style="{StaticResource SessionHint}" Margin="0,12,0,0"/>
          </StackPanel>
          <TextBox x:Name="ConcurrentCallsInput" Grid.Column="1" Text="{Binding ConcurrentCalls.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource SessionInput}" FontSize="30" TextAlignment="Center" VerticalAlignment="Top" Padding="8,16" AutomationProperties.Name="Maximum concurrent tool calls" AutomationProperties.HelpText="Default five. Enter a positive whole number; save to apply."/>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ConcurrentCalls.Error}" Style="{StaticResource SessionError}"/>
        </Grid>
      </Border>
      <Border Style="{StaticResource SessionCard}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Fair queues, not competing chats" Style="{StaticResource SessionBody}" FontWeight="SemiBold"/>
          <TextBlock Text="Independent calls use the available slots. Conflicting file, browser and desktop actions wait for their resource. Lowering a limit lets running work finish; it does not cancel it." Style="{StaticResource SessionHint}" Margin="0,8,0,0"/>
          <Expander Header="Advanced budgets" Margin="0,18,0,0" Foreground="{DynamicResource Text}" IsExpanded="True" AutomationProperties.Name="Advanced execution budgets">
            <ItemsControl ItemsSource="{Binding AdvancedFields}" ItemTemplate="{StaticResource NumericSettingTemplate}"/>
          </Expander>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding HighLoadWarning}" Style="{StaticResource SessionError}" Foreground="{DynamicResource Warning}" Margin="0,16,0,0"/>
      <Border Style="{StaticResource SessionCard}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="{Binding DraftSummary}" Style="{StaticResource SessionBody}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding SyncSummary}" Style="{StaticResource SessionHint}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
          <WrapPanel Margin="0,16,0,0">
            <Button Content="Save limits" Command="{Binding SaveCommand}" Style="{StaticResource SessionPrimary}" Margin="0,0,12,8" AutomationProperties.Name="Save execution limits" ToolTip="Save and apply locally. Ctrl+S"/>
            <Button Content="Reload saved values" Command="{Binding ReloadCommand}" Style="{StaticResource SessionButton}" Margin="0,0,0,8"/>
          </WrapPanel>
          <TextBlock Text="{Binding Status}" Style="{StaticResource SessionHint}" Margin="0,4,0,0"/>
          <TextBlock Text="{Binding Error}" Style="{StaticResource SessionError}"/>
        </StackPanel>
      </Border>
      <TextBlock Text="These are execution budgets for this enrolled agent. Server HTTP rate limits remain separate. Saving limits does not grant tool permissions, arm control, or share chat transcripts." Style="{StaticResource SessionHint}" Margin="0,18,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
