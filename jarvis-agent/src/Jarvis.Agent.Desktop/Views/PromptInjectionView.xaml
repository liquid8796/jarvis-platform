<UserControl x:Class="Jarvis.Agent.Desktop.Views.PromptInjectionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.Name="Prompt injection settings">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/SessionControls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,24,14,20">
      <TextBlock Text="Prompt injection" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
      <TextBlock Text="Your editable prompt presets. Optional context, not additional permissions." Style="{StaticResource SessionHint}" Margin="0,8,0,16"/>
      <Border Style="{StaticResource SessionCard}" Padding="16">
        <StackPanel>
          <CheckBox Content="Attach enabled prompts to MCP replies" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding IsLoaded}" Foreground="{DynamicResource Text}" AutomationProperties.Name="Enable prompt injection"/>
          <TextBlock Text="Applies to all chats using this local agent. Prompt text is sent to the connected MCP server and client. Do not store secrets here. Changes take effect only after Save changes." Style="{StaticResource SessionHint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="Prompts do not grant tool access, override host instructions, bypass anti-cheat, or guarantee account safety. Tool permissions and Arm/Pause remain separate." Style="{StaticResource SessionHint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <WrapPanel Margin="0,14,0,10">
        <Button Content="Add prompt" Command="{Binding AddCommand}" Style="{StaticResource SessionButton}" Margin="0,0,8,4" Padding="12,8"/>
        <Button Content="Delete selected" Command="{Binding DeleteCommand}" Style="{StaticResource SessionButton}" Foreground="{DynamicResource Danger}" Margin="0,0,8,4" Padding="12,8"/>
        <Button Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource SessionButton}" Margin="0,0,8,4" Padding="12,8"/>
      </WrapPanel>
      <TextBlock Text="{Binding Summary}" Style="{StaticResource SessionHint}" Margin="0,0,0,10"/>
      <Grid MinHeight="320">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" Height="330" VerticalAlignment="Top"
                 Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource SessionRow}" AutomationProperties.Name="Prompt preset list">
          <ListBox.ItemTemplate><DataTemplate>
            <Border Padding="10,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}" ToolTip="Enable or disable this prompt in the draft"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="2" IsEnabled="{Binding HasSelection}">
          <TextBlock Text="TITLE" Style="{StaticResource SessionHint}" Margin="0,0,0,6"/>
          <TextBox Text="{Binding Selected.Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SessionInput}" MaxLength="120" AutomationProperties.Name="Prompt title"/>
          <CheckBox Content="Enable this prompt" IsChecked="{Binding Selected.Enabled, Mode=TwoWay}" Foreground="{DynamicResource Text}" Margin="0,10,0,12" AutomationProperties.Name="Enable selected prompt"/>
          <TextBlock Text="PROMPT TEXT" Style="{StaticResource SessionHint}" Margin="0,0,0,6"/>
          <TextBox Text="{Binding Selected.Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SessionInput}" Height="210"
                   MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   VerticalContentAlignment="Top" AutomationProperties.Name="Prompt text"/>
          <TextBlock Text="Up to 4,000 characters per prompt; 16,000 enabled characters in total." Style="{StaticResource SessionHint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
      <Expander Header="Preview context sent to the AI (draft)" Foreground="{DynamicResource Text}" Margin="0,16,0,0" AutomationProperties.Name="Prompt context preview">
        <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                 Style="{StaticResource SessionInput}" Margin="0,10,0,0" AutomationProperties.Name="Prompt context preview text"/>
      </Expander>
      <WrapPanel Margin="0,16,0,8">
        <Button Content="Save changes" Command="{Binding SaveCommand}" Style="{StaticResource SessionButton}" Margin="0,0,8,4" Padding="14,9"/>
        <Button Content="Reload saved" Command="{Binding ReloadCommand}" Style="{StaticResource SessionButton}" Margin="0,0,8,4" Padding="14,9"/>
      </WrapPanel>
      <TextBlock Text="{Binding SavedSummary}" Style="{StaticResource SessionBody}"/>
      <TextBlock Text="{Binding RuntimeStatus}" Style="{StaticResource SessionHint}" Margin="0,6,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Status}" Style="{StaticResource SessionHint}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{Binding Error}" Style="{StaticResource SessionError}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
