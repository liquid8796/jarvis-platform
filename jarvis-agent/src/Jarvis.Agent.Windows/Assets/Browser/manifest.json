{
  "manifest_version": 3,
  "name": "Jarvis Agent Browser",
  "version": "1.1.1",
  "description": "Connect an explicitly authorized browser to Jarvis Agent. Separate integration from Jarvis Code.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "nativeMessaging",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Jarvis Browser"
  }
}
